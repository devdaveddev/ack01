[Unit]
Description=Ack01 hosted site and API
After=network-online.target
Wants=network-online.target

[Service]
User=ack
WorkingDirectory=/opt/ack01
Environment=DATABASE_URL=sqlite:////opt/ack01/data/ack-site.db
# --proxy-headers makes the client address come from Caddy's X-Forwarded-For, so the
# per-IP rate limit sees real visitors instead of one address (127.0.0.1) for everyone.
ExecStart=/opt/ack01/.venv/bin/uvicorn ack.hosted.api:app --host 127.0.0.1 --port 8900 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
